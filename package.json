{
  "name": "promptless",
  "version": "1.0.0",
  "private": true,
  "description": "Promptless monorepo — NestJS + tRPC backend with shared packages",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "turbo run dev --filter=@promptless/api",
    "dev:api": "turbo run dev --filter=@promptless/api",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@promptless/api...",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "typecheck": "turbo run typecheck",
    "start": "pnpm --filter @promptless/api start",
    "start:prod": "pnpm --filter @promptless/api start:prod",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
