generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Impact {
  LOW
  MEDIUM
  HIGH
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  plan      String   @default("free")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces  Workspace[]
  permissions Permission[]
  suggestions Suggestion[]
  memories    MemoryItem[]
  automations Automation[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Permission {
  id        String   @id @default(cuid())
  userId    String
  source    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, source])
}

model Suggestion {
  id             String   @id @default(cuid())
  userId         String
  app            String
  issue          String
  impact         Impact
  timeSavedMins  Int
  status         String   @default("pending")
  explanation    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actions Action[]

  @@index([userId])
  @@index([status])
}

model Action {
  id           String   @id @default(cuid())
  suggestionId String
  type         String
  undoData     Json
  appliedAt    DateTime @default(now())

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@index([suggestionId])
}

model MemoryItem {
  id          String   @id @default(cuid())
  userId      String
  type        String
  text        String
  embeddingId String?
  meta        Json     @default("{}")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model Automation {
  id        String   @id @default(cuid())
  userId    String
  trigger   String
  action    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
