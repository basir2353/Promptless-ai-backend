generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Impact {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("")
  passwordHash String?
  googleId     String?  @unique
  githubId     String?  @unique
  avatarUrl    String?
  plan         String   @default("free")
  settings     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaces  Workspace[]
  permissions Permission[]
  suggestions Suggestion[]
  memories    MemoryItem[]
  automations Automation[]
  devices     DeviceToken[]
  subscription Subscription?
  notifications PushNotification[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Permission {
  id        String   @id @default(cuid())
  userId    String
  source    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, source])
}

model Suggestion {
  id            String    @id @default(cuid())
  userId        String
  app           String
  category      String    @default("automation")
  issue         String
  description   String    @default("")
  impact        Impact
  timeSavedMins Int
  status        String    @default("pending")
  explanation   String
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actions Action[]

  @@index([userId])
  @@index([status])
}

model Action {
  id           String   @id @default(cuid())
  suggestionId String
  type         String
  undoData     Json
  appliedAt    DateTime @default(now())

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@index([suggestionId])
}

model MemoryItem {
  id          String   @id @default(cuid())
  userId      String
  type        String   @default("user_fact")
  text        String
  embeddingId String?
  meta        Json     @default("{}")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model Automation {
  id           String   @id @default(cuid())
  userId       String
  name         String   @default("Automation")
  trigger      String
  action       String
  app          String   @default("general")
  enabled      Boolean  @default(true)
  runsThisWeek Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  platform  String
  provider  String
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, token])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  planId               String   @default("free")
  status               String   @default("active")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushNotification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  status    String   @default("stored")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}