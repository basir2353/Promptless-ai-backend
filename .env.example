# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here
DATABASE_NAME=promptless
DATABASE_SSL=false

# Prisma / full connection string (overrides individual DATABASE_* vars when set)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/promptless

# AI Gateway (Section 15)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# COMPLEX → openai/gpt-4o or anthropic/claude-3.5-sonnet
OPENROUTER_COMPLEX_MODEL=openai/gpt-4o
# SIMPLE → openai/gpt-4o-mini or anthropic/claude-3.5-haiku
OPENROUTER_SIMPLE_MODEL=openai/gpt-4o-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
AI_TEMPERATURE=0.2

# Public URLs
PUBLIC_API_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:5174

# JWT auth (required in production — change this secret)
JWT_SECRET=promptless-dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# Stripe (optional — local checkout is used when empty)
STRIPE_SECRET_KEY=

# FCM (optional — notifications are stored when empty)
FCM_SERVER_KEY=
