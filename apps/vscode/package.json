{
  "name": "promptless-vscode",
  "displayName": "Promptless",
  "description": "Capture VS Code workspace context into Promptless memory",
  "version": "1.0.0",
  "publisher": "promptless",
  "engines": { "vscode": "^1.90.0" },
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "promptless.capture",
        "title": "Promptless: Capture workspace context"
      }
    ]
  }
}
